# Copy this file to .env and replace every placeholder before starting Compose.
POSTGRES_DB=frauddect
POSTGRES_USER=frauddetect
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET

FRAUDDETECT_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRAUDDETECT_API_KEY=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
FRAUDDETECT_ADMIN_USERNAME=admin
FRAUDDETECT_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

FRAUDDETECT_BIND_ADDRESS=127.0.0.1
FRAUDDETECT_HTTP_PORT=8080
